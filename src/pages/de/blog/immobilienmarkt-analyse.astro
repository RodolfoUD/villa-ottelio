<td class="border border-villa-gold/20 p-4 text-gray-600">Auto / Bus</td>
<td class="border border-villa-gold/20 p-4">29-35 Minuten</td>
<td class="border border-villa-gold/20 p-4">25 km</td>
</tr>
<tr>
<td class="border border-villa-gold/20 p-4 font-medium text-gray-900">Venedig (Piazzale Roma)</td>
<td class="border border-villa-gold/20 p-4 text-gray-600">Auto / Zug</td>
<td class="border border-villa-gold/20 p-4">1h 20m - 1h 40m</td>
<td class="border border-villa-gold/20 p-4">130 km</td>
</tr>
<tr class="bg-gray-50">
<td class="border border-villa-gold/20 p-4 font-medium text-gray-900">Wien (Hauptbahnhof)</td>
