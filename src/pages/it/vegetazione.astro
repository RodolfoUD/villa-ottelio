<!-- ========== END FOOTER ========== -->`;
const alternates = { it: 'https://www.villaottelio.it/it/vegetazione.html', en: 'https://www.villaottelio.it/nature.html', fr: 'https://www.villaottelio.it/fr/nature.html', de: 'https://www.villaottelio.it/de/botanik.html', nl: 'https://www.villaottelio.it/nl/botanica.html', zh: 'https://www.villaottelio.it/zh/nature.html' };
