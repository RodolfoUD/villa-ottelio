<meta content="La Vegetazione (Flora) | Villa Ottelio de Carvalho" property="twitter:title"/>
<meta content="Platani secolari, uliveto storico, cipressi e giardino produttivo nel cuore dei Colli Orientali del Friuli." property="twitter:description"/>
