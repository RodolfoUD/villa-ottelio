<meta content="Esterni e Giardino | Villa Ottelio de Carvalho" property="og:title"/>
<meta content="Un'oasi protetta tra ulivi, tigli secolari e i panorami dei Colli Orientali del Friuli." property="og:description"/>
<meta content="https://www.villaottelio.it/assets/images/shared/esterni/villa-giardino-inverno.webp" property="og:image"/>
