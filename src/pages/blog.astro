const alternates = { it: 'https://www.villaottelio.it/it/blog.html', en: 'https://www.villaottelio.it/blog.html', fr: 'https://www.villaottelio.it/fr/blog.html', de: 'https://www.villaottelio.it/de/blog.html', nl: 'https://www.villaottelio.it/nl/blog.html', zh: 'https://www.villaottelio.it/zh/blog.html' };
