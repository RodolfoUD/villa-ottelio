<Layout
  lang="zh"
  pageKey="park"
  title={`花园与户外空间 | Villa Ottelio de Carvalho`}
  description={`Villa Ottelio de Carvalho的花园和户外空间：橄榄树、百年椴树、私人小教堂以及Colli Orientali del Friuli的壮丽景观。`}
  canonical="https://www.villaottelio.it/zh/the-garden.html"
  alternates={alternates}
  headExtra={headExtra}
>
  <Fragment set:html={content} />
