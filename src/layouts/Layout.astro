---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, GA_ID } from '../data/site.js';

const {
  lang = 'en',
  pageKey = '',
  title,
  description = '',
  canonical,
  alternates = {},
  headExtra = '',
  bodyClass = 'bg-villa-black text-white font-sans antialiased',
} = Astro.props;

const htmlLang = site[lang]?.htmlLang || 'en';
---
<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <!-- Google Analytics 4 — Consent Mode v2 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content="index, follow" />

    <!-- og:* / twitter:* / JSON-LD / hreflang specifici della pagina,
         preservati verbatim dal sito originale -->
    <Fragment set:html={headExtra} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.0.0/css/flag-icons.min.css"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    <Header lang={lang} pageKey={pageKey} alternates={alternates} />
    <slot />
    <Footer lang={lang} />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fslightbox/3.4.1/index.min.js" is:inline></script>
    <script src="/cookie-banner.js" is:inline></script>
  </body>
</html>
